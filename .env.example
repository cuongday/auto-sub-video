# Gemini qua Vertex AI (ADC)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_LOCATION=global
# Đường dẫn file ADC trên máy (bỏ trống nếu chỉ dùng OpenAI). Ví dụ:
#   Linux/macOS: /home/<user>/.config/gcloud/application_default_credentials.json
#   Windows:     C:/Users/<user>/AppData/Roaming/gcloud/application_default_credentials.json
ADC_HOST_PATH=

# OpenAI (tuỳ chọn)
# OPENAI_API_KEY=sk-...

# Tuỳ chọn
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1-mini
# VIENEU_MODE=v3turbo
# AUTOSUB_VOICE_WORKERS=4
# AUTOSUB_FFMPEG_PRESET=veryfast
# AUTOSUB_FFMPEG_CRF=20
# AUTOSUB_PORT=8020

# Docker (docker compose)
# Thư mục video được duyệt trên web (chỉ đọc). Mặc định: thư mục videos/ trong project. Ví dụ:
#   Linux:   HOST_ROOT=/home/<user>/Videos      macOS: HOST_ROOT=/Users/<user>/Movies
#   Windows: HOST_ROOT=C:/Users/<user>/Videos   (dùng dấu /, Docker Desktop tự chuyển)
# HOST_ROOT=
# AUTOSUB_BIND=127.0.0.1        # 0.0.0.0 để máy khác trong mạng LAN truy cập được (họ cũng duyệt được HOST_ROOT)
# AUTOSUB_PASSWORD=             # đặt mật khẩu đăng nhập web (nên đặt khi AUTOSUB_BIND=0.0.0.0)
# UID=1000
# GID=1000

# MinIO (bắt buộc): nơi lưu toàn bộ dữ liệu job
MINIO_ROOT_USER=autosub
MINIO_ROOT_PASSWORD=change-me-please
# MINIO_BUCKET=autosub
# MINIO_CONSOLE_PORT=9201
# AUTOSUB_WORK_MAX_GB=20      # giới hạn thư mục tạm trong container
