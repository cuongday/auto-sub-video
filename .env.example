# Gemini qua Vertex AI (ADC)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_LOCATION=global
ADC_HOST_PATH=/home/you/.config/gcloud/application_default_credentials.json

# OpenAI (tuỳ chọn)
# OPENAI_API_KEY=sk-...

# Tuỳ chọn
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1-mini
# VIENEU_MODE=v3turbo
# AUTOSUB_VOICE_WORKERS=4
# AUTOSUB_FFMPEG_PRESET=veryfast
# AUTOSUB_FFMPEG_CRF=20
# AUTOSUB_PORT=8020

# Docker (docker compose)
# VIDEOS_DIR=/home/you/Videos   # thư mục video trên máy, trong app mở bằng đường dẫn /videos/<tên file>
# UID=1000
# GID=1000

# MinIO (bắt buộc): nơi lưu toàn bộ dữ liệu job
MINIO_ROOT_USER=autosub
MINIO_ROOT_PASSWORD=change-me-please
# MINIO_BUCKET=autosub
# MINIO_CONSOLE_PORT=9201
# AUTOSUB_WORK_MAX_GB=20      # giới hạn thư mục tạm trong container
